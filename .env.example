# ── Application ───────────────────────────────────────────────
APP_NAME=arem-shop
APP_ENV=development
APP_PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=arem_shop
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_TTL_HOURS=24

# ── Security ──────────────────────────────────────────────────
BCRYPT_COST=12

# ── Business ──────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5
