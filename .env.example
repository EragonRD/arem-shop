# Application
APP_NAME=arem-shop
APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://*.app.github.dev

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=arem_shop
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_TTL_HOURS=24

# Security
BCRYPT_COST=12

# Business
LOW_STOCK_THRESHOLD=5

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DATA_MODE=api
